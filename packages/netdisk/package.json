{
  "name": "@zakobot/netdisk",
  "version": "0.2.0",
  "description": "Simple expiring file sharing service for ZakoBot",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": ["dist"],
